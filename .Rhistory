- [@cottineau2026rethinking]: This is a review of the book "Rethinking Spatial Inequality", by Linda M. Lobao and Gregory Hooks.
---
title: "R Workshop: Updating urban segregation computation"
library(leaflet)
leaflet() %>%
setView(4.3705259, 52.0056562, 9) %>%
addProviderTiles(providers$CartoDB.Positron) %>%
addCircleMarkers(
lng = 4.3705259, lat = 52.0056562,
label = "TU Delft | Faculty of Architecture and the Built Environment | 9th Nov.",
radius = 10,
color = "#ff6600ff",
stroke = FALSE, fillOpacity = 0.5) %>%
addCircleMarkers(
lng = 4.3730109, lat = 52.0026415,
label = "TU Delft Library | 10-13th Nov.",
radius = 15,
color = "#ff6600ff",
stroke = FALSE, fillOpacity = 0.5)
leaflet() %>%
setView(4.3705259, 52.0056562, 9) %>%
addTiles() %>%
addCircleMarkers(
lng = 4.3705259, lat = 52.0056562,
label = "TU Delft | Faculty of Architecture and the Built Environment | 9th Nov.",
radius = 10,
color = "#ff6600ff",
stroke = FALSE, fillOpacity = 0.5) %>%
addCircleMarkers(
lng = 4.3730109, lat = 52.0026415,
label = "TU Delft Library | 10-13th Nov.",
radius = 15,
color = "#ff6600ff",
stroke = FALSE, fillOpacity = 0.5)
